{
  "name": "scav",
  "version": "1.0.0",
  "description": "Scav frontend",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:host": "vite --host 0.0.0.0 --port 5173",
    "preview": "vite preview --host 0.0.0.0",
    "prebuild": "node --experimental-strip-types scripts/generate-manifest.ts",
    "build": "npm run generate-sitemap && vite build",
    "build:analyze": "vite build --analyze",
    "generate-manifest": "node --experimental-strip-types scripts/generate-manifest.ts",
    "generate-sitemap": "node --experimental-strip-types scripts/generate-sitemap.ts",
    "lint": "eslint . --ext .js,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-migrate": "ts-migrate",
    "check:css": "node scripts/check-css.js",
    "check:project": "node scripts/check-project.mjs",
    "check:backend": "node scripts/check-backend-health.mjs",
    "verify": "npm run check:project && npm run check:backend",
    "fix:css": "npx stylelint \"css/**/*.css\" --fix"
  },
  "author": "scav",
  "license": "ISC",
  "dependencies": {
    "cropperjs": "^2.2.0",
    "hls.js": "^1.6.10",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.43.1",
    "uuid": "^11.1.0",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@types/cropperjs": "^1.1.5",
    "eslint": "^9.39.5",
    "glob": "^13.0.6",
    "prettier": "^3.2.5",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "ts-migrate": "^0.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite-plugin-mkcert": "^2.0.0"
  }
}